Algoritmo "teste_para"

Var
   n, i, x soma: inteiro


Inicio
      escreva("quantos numeros serão digitados?")
      leia(n)
      
      soma <- 0
      
      para i de 1 ate n faca
           escreva("digite um numero: ")
           leia(x)
      fimpara
      
      escreval("soma= ",soma)

Fimalgoritmo