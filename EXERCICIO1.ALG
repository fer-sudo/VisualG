Algoritmo "exercicio1"

Var

   produto1, produto2, genero : caractere
   preco1, preco2 : real
   idade, codigo : inteiro



Inicio

      idade <- 30
      preco1 <- 2100.5
      preco2 <- 1830.0
      produto1 <- "computador"
      produto2 <- "tv"
      idade <-30
      codigo <- 5291
      genero <- "F"

      escreval("produto:")
      escreval("o produto ", produto1, " custa R$", preco1:8:2)
      escreval("o produto ", produto2, " custa R$ ", preco1:8:2)
      escreval
      escreval("codigo= ", codigo)
      escreval
      escreval("dados da pessoa: genero ", genero, " e idade ", idade)



Fimalgoritmo