Algoritmo "soma"
// Disciplina   : [Linguagem e Lógica de Programação] 
// Professor   : Antonio Carlos Nicolodi 

Var

     x, y : inteiro
      soma : real

Inicio

      escreva("digite o valor de x:")
      leia(x)
      escreva("digite o valor de y:")
      leia(y)
      
      soma <- x + y
      
      escreval ("soma: ", soma)

Fimalgoritmo