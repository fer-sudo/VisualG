Algoritmo "teste_enquanto"

Var

   x, soma: inteiro

Inicio

      escreval("digite o primeiro numero: ")
      leia(x)
      
      enquanto x <> 0 faca
               soma<- soma + x
               escreval("digite outro numero: ")
               leia(x)
      fimenquanto
      
                 escreval("soma= ", soma)

Fimalgoritmo